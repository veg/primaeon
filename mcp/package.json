{
  "name": "@veg/hyphaeon-mcp",
  "version": "0.2.0",
  "description": "MCP server for HyphAeon: site selection, omnibus, epistasis, digital DMS, phenotype association and MEME concordance over stdio or streamable HTTP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/veg/hyphaeon-app.git",
    "directory": "mcp"
  },
  "bin": {
